# Copy to .env.local and fill in. Never commit .env.local.

# --- Supabase (public: safe in the browser, protected by Row Level Security) ---
# Leave both empty to run in demo mode with example data (docs/DECISIONS.md, ADR-015).
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# --- Server only ---
# Used by Supabase Edge Functions (tick runner, quarter close) and admin scripts.
# Must never be referenced from code under src/ and never get a NEXT_PUBLIC_ prefix.
SUPABASE_SERVICE_ROLE_KEY=

# Shared secret that pg_cron sends to the tick-runner Edge Function (M1).
TICK_RUNNER_SECRET=

# --- Optional ---
# Public URL of the deployment, used for auth redirect links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000
